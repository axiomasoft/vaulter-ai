# Ephemeral values below are generated per run into .fixture/<run-id>/.env by ./stack.sh prepare.
STAND_PROFILE=ai-text
STAND_RUN_ID=sample-run
COMPOSE_PROJECT_NAME=vaulter_ai_office_sample
OWNER_HTTP_PORT=18000

PG_USER=vaulter
PG_PASSWORD=change-me-ephemeral
PG_DB=vaulter_ai_office

APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
FIXTURE_TOKEN=change-me-fixture-token

# Set only for opt-in live-model smoke runs; NEVER pass to owner-http or python-client.
VAULTER_AI_PROVIDER=openai
VAULTER_AI_MODEL=gpt-4o-mini
VAULTER_AI_PROVIDER_KEY=
VAULTER_AI_DETERMINISTIC_SCRIPT=1
DB_QUEUE_RETRY_AFTER=100
SESSION_DRIVER=array
