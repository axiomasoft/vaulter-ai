{
    "name": "axiomasoft/vaulter-ai-monorepo",
    "description": "Vaulter AI — Office AI SDK, resumable chat and executors (private monorepo workspace).",
    "type": "project",
    "license": "proprietary",
    "homepage": "https://github.com/axiomasoft/vaulter-ai",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/axiomasoft/vaulter-ai/issues",
        "source": "https://github.com/axiomasoft/vaulter-ai"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/vaulter-ai-core": "1.0.x-dev",
                    "axiomasoft/vaulter-ai-collaboration": "1.0.x-dev",
                    "axiomasoft/vaulter-ai-documents": "1.0.x-dev",
                    "axiomasoft/vaulter-ai-sheets": "1.0.x-dev",
                    "axiomasoft/vaulter-ai-laravel-ai": "1.0.x-dev",
                    "axiomasoft/vaulter-ai-agentools": "1.0.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../agentools/php",
            "options": {
                "symlink": true,
                "versions": {
                    "agentools/sdk": "1.0.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../vaulter-sheets/packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/vaulter-sheets": "1.0.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../vaulter-collaboration/packages/collaboration",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/vaulter-collaboration": "1.0.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../vaulter/packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/vaulter-core": "1.0.x-dev",
                    "axiomasoft/vaulter-drive": "1.0.x-dev",
                    "axiomasoft/vaulter-documents": "1.0.x-dev",
                    "axiomasoft/vaulter-media": "1.0.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../packman/packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/packman": "0.1.1",
                    "axiomasoft/packman-devtools": "0.1.1",
                    "axiomasoft/packman-plugins": "0.1.1",
                    "axiomasoft/packman-schema": "0.1.1",
                    "axiomasoft/packman-testkit": "0.1.1"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.4 <8.6",
        "axiomasoft/vaulter-ai-agentools": "^1.0",
        "axiomasoft/vaulter-ai-collaboration": "^1.0",
        "axiomasoft/vaulter-ai-core": "^1.0",
        "axiomasoft/vaulter-ai-documents": "^1.0",
        "axiomasoft/vaulter-ai-laravel-ai": "^1.0",
        "axiomasoft/vaulter-ai-sheets": "^1.0"
    },
    "require-dev": {
        "axiomasoft/vaulter-media": "^1.0",
        "larastan/larastan": "^3.15",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-type-coverage": "^5.1",
        "phpstan/phpstan": "^2.3.6",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "spaze/phpstan-disallowed-calls": "^4.15.1",
        "symfony/yaml": "^8.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Vaulter\\Ai\\Ci\\": "scripts/ci/",
            "Vaulter\\Ai\\Tests\\": "tests/",
            "Vaulter\\Ai\\Core\\Tests\\": "packages/core/tests/",
            "Vaulter\\Ai\\Collaboration\\Tests\\": "packages/collaboration/tests/",
            "Vaulter\\Ai\\Documents\\Tests\\": "packages/documents/tests/",
            "Vaulter\\Ai\\Sheets\\Tests\\": "packages/sheets/tests/",
            "Vaulter\\Ai\\LaravelAi\\Tests\\": "packages/laravel-ai/tests/",
            "Vaulter\\Ai\\AgenTools\\Tests\\": "packages/agentools/tests/"
        }
    },
    "extra": {
        "phpstan/extension-installer": {
            "ignore": [
                "larastan/larastan",
                "nesbot/carbon",
                "pestphp/pest",
                "phpstan/phpstan-strict-rules",
                "spaze/phpstan-disallowed-calls"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "process-timeout": 1800,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": false,
            "phpstan/extension-installer": true,
            "tbachert/spi": false
        }
    },
    "scripts": {
        "lint": "@php vendor/bin/pint",
        "lint:check": "@php vendor/bin/pint --test",
        "test": "@php vendor/bin/pest -c phpunit.xml.dist",
        "phpstan": "@php vendor/bin/phpstan analyse -c phpstan.neon.dist --memory-limit=1G --no-progress"
    }
}
