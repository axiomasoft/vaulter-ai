{
    "name": "axiomasoft/vaulter-ai-laravel-ai",
    "description": "Vaulter AI Laravel AI executor adapter: OfficeAgent, OfficeTool, and resumable step execution over Office SDK core.",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://github.com/axiomasoft/vaulter-ai",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4 <8.6",
        "axiomasoft/vaulter-ai-core": "^1.0",
        "illuminate/bus": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/json-schema": "^13.15",
        "illuminate/queue": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/ai": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Vaulter\\Ai\\LaravelAi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vaulter\\Ai\\LaravelAi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vaulter\\Ai\\LaravelAi\\LaravelAiServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
