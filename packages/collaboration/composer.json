{
    "name": "axiomasoft/vaulter-ai-collaboration",
    "description": "Vaulter AI adapter for strict live-text commands and read markers over Vaulter Collaboration.",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://github.com/axiomasoft/vaulter-ai",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4 <8.6",
        "axiomasoft/vaulter-ai-core": "self.version",
        "axiomasoft/vaulter-ai-documents": "self.version",
        "axiomasoft/vaulter-collaboration": "self.version",
        "axiomasoft/vaulter-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Vaulter\\Ai\\Collaboration\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vaulter\\Ai\\Collaboration\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vaulter\\Ai\\Collaboration\\CollaborationAiServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
