{
    "name": "axiomasoft/vaulter-ai-core",
    "description": "Vaulter AI Office SDK core: wire protocol v1, JCS proposal digest, registry, search/read/describe operations and HTTP controller.",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://github.com/axiomasoft/vaulter-ai",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4 <8.6",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "opis/json-schema": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "Vaulter\\Ai\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vaulter\\Ai\\Core\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vaulter\\Ai\\Core\\OfficeServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
