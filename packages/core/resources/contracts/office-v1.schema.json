{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vaulter Office SDK v1 — сообщение",
  "description": "Одно сообщение: запрос, успешный результат или ошибка. Профиль первых двух команд закрытого SDK. Контекст субъекта устанавливает авторизованный транспорт.",
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/success"}, {"$ref": "#/$defs/failure"}],
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 строчным hex от UTF-8 RFC 8785 {version:1,prepare_input,plan без digest}; профиль чисел — безопасные целые. Векторы: plan/examples/reference/proposal-digest/vectors.json"},
    "marker": {
      "type": "object",
      "required": ["generation", "position"],
      "properties": {"generation": {"$ref": "#/$defs/counter"}, "position": {"$ref": "#/$defs/counter"}},
      "additionalProperties": false
    },
    "counter": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "operation": {
      "enum": [
        "office.search",
        "office.read",
        "office.describe",
        "office.prepare",
        "office.commit",
        "office.status",
        "office.verify"
      ]
    },
    "command": {"enum": ["text.replace_exact@1", "sheet.fill_formula@1"]},
    "resourceType": {"enum": ["text", "sheet"]},
    "mode": {"enum": ["at_commit", "current"]},
    "cellValue": {"type": ["string", "number", "boolean", "null"]},
    "limit": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "searchInput": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": {"type": "string"},
        "resource_type": {"$ref": "#/$defs/resourceType"},
        "limit": {"$ref": "#/$defs/limit"},
        "cursor": {"$ref": "#/$defs/id"}
      },
      "additionalProperties": false
    },
    "searchResult": {
      "type": "object",
      "required": ["items", "truncated", "next_cursor"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["resource_id", "resource_type", "title"],
            "properties": {
              "resource_id": {"$ref": "#/$defs/id"},
              "resource_type": {"$ref": "#/$defs/resourceType"},
              "title": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "truncated": {"type": "boolean"},
        "next_cursor": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"required": ["truncated"], "properties": {"truncated": {"const": false}}},
          "then": {"properties": {"next_cursor": {"type": "null"}}}
        },
        {
          "if": {"required": ["truncated"], "properties": {"truncated": {"const": true}}},
          "then": {"properties": {"next_cursor": {"$ref": "#/$defs/id"}}}
        }
      ]
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": {"kind": {"const": "text_outline"}, "query": {"type": "string"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "block_id"],
          "properties": {"kind": {"const": "text_block"}, "block_id": {"$ref": "#/$defs/id"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {"kind": {"const": "sheet_catalog"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "sheet_id", "table_id", "columns"],
          "properties": {
            "kind": {"const": "sheet_table"},
            "sheet_id": {"$ref": "#/$defs/id"},
            "table_id": {"$ref": "#/$defs/id"},
            "columns": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 1, "uniqueItems": true},
            "row_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 1, "uniqueItems": true}
          },
          "additionalProperties": false
        }
      ]
    },
    "readInput": {
      "type": "object",
      "required": ["resource_id", "selector"],
      "properties": {
        "resource_id": {"$ref": "#/$defs/id"},
        "selector": {"$ref": "#/$defs/selector"},
        "limit": {"$ref": "#/$defs/limit"},
        "cursor": {"$ref": "#/$defs/id"},
        "after_receipt": {"$ref": "#/$defs/id"}
      },
      "additionalProperties": false
    },
    "outlineEntry": {
      "type": "object",
      "required": ["block_id", "path", "snippet"],
      "properties": {
        "block_id": {"$ref": "#/$defs/id"},
        "path": {"type": "array", "items": {"type": "string"}},
        "snippet": {"type": "string"}
      },
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "required": ["text", "marks"],
      "properties": {
        "text": {"type": "string"},
        "marks": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "tableEntry": {
      "type": "object",
      "required": ["sheet_id", "sheet_title", "table_id", "table_title", "columns"],
      "properties": {
        "sheet_id": {"$ref": "#/$defs/id"},
        "sheet_title": {"type": "string"},
        "table_id": {"$ref": "#/$defs/id"},
        "table_title": {"type": "string"},
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["column_id", "title"],
            "properties": {"column_id": {"$ref": "#/$defs/id"}, "title": {"type": "string"}},
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "sheetRow": {
      "type": "object",
      "required": ["row_id", "values"],
      "properties": {
        "row_id": {"$ref": "#/$defs/id"},
        "values": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"$ref": "#/$defs/cellValue"}
        }
      },
      "additionalProperties": false
    },
    "readData": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "blocks"],
          "properties": {
            "kind": {"const": "text_outline"},
            "blocks": {"type": "array", "items": {"$ref": "#/$defs/outlineEntry"}}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "block_id", "segments"],
          "properties": {
            "kind": {"const": "text_block"},
            "block_id": {"$ref": "#/$defs/id"},
            "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "tables"],
          "properties": {
            "kind": {"const": "sheet_catalog"},
            "tables": {"type": "array", "items": {"$ref": "#/$defs/tableEntry"}}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "sheet_id", "table_id", "rows"],
          "properties": {
            "kind": {"const": "sheet_table"},
            "sheet_id": {"$ref": "#/$defs/id"},
            "table_id": {"$ref": "#/$defs/id"},
            "rows": {"type": "array", "items": {"$ref": "#/$defs/sheetRow"}}
          },
          "additionalProperties": false
        }
      ]
    },
    "readResult": {
      "type": "object",
      "required": ["marker", "read_token", "data", "truncated", "next_cursor"],
      "properties": {
        "marker": {"$ref": "#/$defs/marker"},
        "read_token": {"$ref": "#/$defs/id"},
        "data": {"$ref": "#/$defs/readData"},
        "truncated": {"type": "boolean"},
        "next_cursor": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"required": ["truncated"], "properties": {"truncated": {"const": false}}},
          "then": {"properties": {"next_cursor": {"type": "null"}}}
        },
        {
          "if": {"required": ["truncated"], "properties": {"truncated": {"const": true}}},
          "then": {"properties": {"next_cursor": {"$ref": "#/$defs/id"}}}
        }
      ]
    },
    "textArguments": {
      "type": "object",
      "required": ["block_id", "expected", "replacement"],
      "properties": {
        "block_id": {"$ref": "#/$defs/id"},
        "expected": {"$ref": "#/$defs/id"},
        "replacement": {"type": "string"}
      },
      "additionalProperties": false
    },
    "formulaExpression": {
      "type": "object",
      "required": ["op", "left_column_id", "right_column_id"],
      "properties": {
        "op": {"const": "subtract"},
        "left_column_id": {"$ref": "#/$defs/id"},
        "right_column_id": {"$ref": "#/$defs/id"}
      },
      "additionalProperties": false
    },
    "sheetArguments": {
      "type": "object",
      "required": ["sheet_id", "table_id", "scope", "destination_column_id", "expression"],
      "properties": {
        "sheet_id": {"$ref": "#/$defs/id"},
        "table_id": {"$ref": "#/$defs/id"},
        "scope": {"enum": ["fixed_members", "current_rows"]},
        "destination_column_id": {"$ref": "#/$defs/id"},
        "expression": {"$ref": "#/$defs/formulaExpression"}
      },
      "additionalProperties": false
    },
    "describeInput": {
      "type": "object",
      "required": ["resource_id", "command"],
      "properties": {"resource_id": {"$ref": "#/$defs/id"}, "command": {"$ref": "#/$defs/command"}},
      "additionalProperties": false
    },
    "describeResult": {
      "oneOf": [
        {
          "type": "object",
          "required": ["command", "effect", "input_schema", "verification"],
          "properties": {
            "command": {"const": "text.replace_exact@1"},
            "effect": {"const": "single_resource_write"},
            "input_schema": {
              "type": "object",
              "required": ["type", "required", "properties", "additionalProperties"],
              "properties": {
                "type": {"const": "object"},
                "additionalProperties": {"const": false},
                "required": {
                  "type": "array",
                  "items": {"enum": ["block_id", "expected", "replacement"]},
                  "uniqueItems": true,
                  "minItems": 3,
                  "maxItems": 3
                },
                "properties": {
                  "type": "object",
                  "required": ["block_id", "expected", "replacement"],
                  "properties": {
                    "block_id": {"type": "object"},
                    "expected": {"type": "object"},
                    "replacement": {"type": "object"}
                  },
                  "additionalProperties": false
                }
              }
            },
            "verification": {"const": "text_and_marks"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["command", "effect", "input_schema", "verification"],
          "properties": {
            "command": {"const": "sheet.fill_formula@1"},
            "effect": {"const": "single_resource_write"},
            "input_schema": {
              "type": "object",
              "required": ["type", "required", "properties", "additionalProperties"],
              "properties": {
                "type": {"const": "object"},
                "additionalProperties": {"const": false},
                "required": {
                  "type": "array",
                  "items": {"enum": ["sheet_id", "table_id", "scope", "destination_column_id", "expression"]},
                  "uniqueItems": true,
                  "minItems": 5,
                  "maxItems": 5
                },
                "properties": {
                  "type": "object",
                  "required": ["sheet_id", "table_id", "scope", "destination_column_id", "expression"],
                  "properties": {
                    "sheet_id": {"type": "object"},
                    "table_id": {"type": "object"},
                    "scope": {"type": "object"},
                    "destination_column_id": {"type": "object"},
                    "expression": {"type": "object"}
                  },
                  "additionalProperties": false
                }
              }
            },
            "verification": {"const": "formula_and_values"}
          },
          "additionalProperties": false
        }
      ]
    },
    "prepareInput": {
      "oneOf": [
        {
          "type": "object",
          "required": ["resource_id", "command", "read_token", "arguments"],
          "properties": {
            "resource_id": {"$ref": "#/$defs/id"},
            "command": {"const": "text.replace_exact@1"},
            "read_token": {"$ref": "#/$defs/id"},
            "arguments": {"$ref": "#/$defs/textArguments"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["resource_id", "command", "read_token", "arguments"],
          "properties": {
            "resource_id": {"$ref": "#/$defs/id"},
            "command": {"const": "sheet.fill_formula@1"},
            "read_token": {"$ref": "#/$defs/id"},
            "arguments": {"$ref": "#/$defs/sheetArguments"}
          },
          "additionalProperties": false
        }
      ]
    },
    "prepareResult": {
      "type": "object",
      "required": ["proposal_id", "digest", "base", "approval", "summary", "targets", "expires_at"],
      "properties": {
        "proposal_id": {"$ref": "#/$defs/id"},
        "digest": {"$ref": "#/$defs/digest"},
        "base": {"$ref": "#/$defs/marker"},
        "approval": {"enum": ["automatic", "human"]},
        "summary": {"type": "string"},
        "targets": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 1, "uniqueItems": true},
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "Дата истечения в UTC. Для проверки календарной даты валидатор включает проверку формата date-time.",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)([.][0-9]+)?(Z|[+]00:00)$"
        }
      },
      "additionalProperties": false
    },
    "commitInput": {
      "type": "object",
      "required": ["resource_id", "proposal_id", "digest", "command_id"],
      "properties": {
        "resource_id": {"$ref": "#/$defs/id"},
        "proposal_id": {"$ref": "#/$defs/id"},
        "digest": {"$ref": "#/$defs/digest"},
        "command_id": {"$ref": "#/$defs/id"}
      },
      "additionalProperties": false
    },
    "running": {
      "type": "object",
      "required": ["command_id", "state"],
      "properties": {"command_id": {"$ref": "#/$defs/id"}, "state": {"const": "running"}},
      "additionalProperties": false
    },
    "committed": {
      "type": "object",
      "required": ["command_id", "state", "receipt_id", "marker"],
      "properties": {
        "command_id": {"$ref": "#/$defs/id"},
        "state": {"const": "committed"},
        "receipt_id": {"$ref": "#/$defs/id"},
        "marker": {"$ref": "#/$defs/marker"}
      },
      "additionalProperties": false
    },
    "commitResult": {"oneOf": [{"$ref": "#/$defs/running"}, {"$ref": "#/$defs/committed"}]},
    "statusInput": {
      "type": "object",
      "required": ["resource_id", "command_id"],
      "properties": {"resource_id": {"$ref": "#/$defs/id"}, "command_id": {"$ref": "#/$defs/id"}},
      "additionalProperties": false
    },
    "statusResult": {
      "oneOf": [
        {"$ref": "#/$defs/running"},
        {"$ref": "#/$defs/committed"},
        {
          "type": "object",
          "required": ["command_id", "state", "reason"],
          "properties": {
            "command_id": {"$ref": "#/$defs/id"},
            "state": {"const": "rejected"},
            "reason": {"$ref": "#/$defs/reason"}
          },
          "additionalProperties": false
        }
      ]
    },
    "verifyInput": {
      "type": "object",
      "required": ["resource_id", "receipt_id", "mode"],
      "properties": {
        "resource_id": {"$ref": "#/$defs/id"},
        "receipt_id": {"$ref": "#/$defs/id"},
        "mode": {"$ref": "#/$defs/mode"}
      },
      "additionalProperties": false
    },
    "check": {
      "oneOf": [
        {
          "type": "object",
          "required": ["name", "passed", "actual"],
          "properties": {"name": {"enum": ["text_exact"]}, "passed": {"type": "boolean"}, "actual": {"type": "string"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["name", "passed", "actual"],
          "properties": {
            "name": {"enum": ["marks", "row_ids", "formulas"]},
            "passed": {"type": "boolean"},
            "actual": {"type": "array", "items": {"$ref": "#/$defs/id"}}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["name", "passed", "actual"],
          "properties": {
            "name": {"enum": ["calculated_values"]},
            "passed": {"type": "boolean"},
            "actual": {"type": "array", "items": {"$ref": "#/$defs/cellValue"}}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["name", "passed", "actual"],
          "properties": {
            "name": {"enum": ["calculated_at"]},
            "passed": {"type": "boolean"},
            "actual": {"$ref": "#/$defs/marker"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["name", "passed", "actual"],
          "properties": {"name": {"enum": ["sum"]}, "passed": {"type": "boolean"}, "actual": {"type": "number"}},
          "additionalProperties": false
        }
      ]
    },
    "verifyResult": {
      "type": "object",
      "required": ["receipt_id", "mode", "outcome", "marker", "checks"],
      "properties": {
        "receipt_id": {"$ref": "#/$defs/id"},
        "mode": {"$ref": "#/$defs/mode"},
        "outcome": {"enum": ["passed", "failed"]},
        "marker": {"$ref": "#/$defs/marker"},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}, "minItems": 1}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"required": ["outcome"], "properties": {"outcome": {"const": "passed"}}},
          "then": {
            "properties": {
              "checks": {
                "items": {"properties": {"passed": {"const": true}}},
                "oneOf": [
                  {
                    "maxItems": 2,
                    "allOf": [
                      {"contains": {"properties": {"name": {"const": "text_exact"}}}},
                      {"contains": {"properties": {"name": {"const": "marks"}}}}
                    ]
                  },
                  {
                    "maxItems": 5,
                    "allOf": [
                      {"contains": {"properties": {"name": {"const": "row_ids"}, "actual": {"minItems": 1, "uniqueItems": true}}}},
                      {"contains": {"properties": {"name": {"const": "formulas"}, "actual": {"minItems": 1, "items": {"type": "string", "minLength": 2, "pattern": "^="}}}}},
                      {"contains": {"properties": {"name": {"const": "calculated_values"}, "actual": {"minItems": 1, "items": {"type": "number"}}}}},
                      {"contains": {"properties": {"name": {"const": "calculated_at"}}}},
                      {"contains": {"properties": {"name": {"const": "sum"}}}}
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {"required": ["outcome"], "properties": {"outcome": {"const": "failed"}}},
          "then": {"properties": {"checks": {"contains": {"properties": {"passed": {"const": false}}}}}}
        }
      ]
    },
    "reason": {
      "enum": [
        "invalid_input",
        "unsupported_version",
        "authentication_required",
        "resource_unavailable",
        "idempotency_conflict",
        "unsupported_content",
        "operation_unknown",
        "precondition_failed",
        "scope_changed",
        "generation_changed",
        "schema_changed",
        "proposal_expired",
        "cursor_expired",
        "read_token_expired",
        "approval_required",
        "projection_pending",
        "calculation_pending",
        "evidence_unavailable",
        "idempotency_window_expired",
        "limit_exceeded",
        "temporarily_unavailable"
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "object",
          "required": ["code", "retryable", "next_action"],
          "properties": {
            "code": {
              "enum": [
                "invalid_input",
                "unsupported_version",
                "authentication_required",
                "resource_unavailable",
                "idempotency_conflict",
                "unsupported_content"
              ]
            },
            "retryable": {"const": false},
            "next_action": {"enum": ["stop"]}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["code", "retryable", "next_action"],
          "properties": {
            "code": {"enum": ["operation_unknown"]},
            "retryable": {"const": true},
            "next_action": {"enum": ["retry_same"]}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["code", "retryable", "next_action"],
          "properties": {
            "code": {
              "enum": [
                "precondition_failed",
                "scope_changed",
                "generation_changed",
                "schema_changed",
                "proposal_expired",
                "cursor_expired",
                "read_token_expired"
              ]
            },
            "retryable": {"const": false},
            "next_action": {"enum": ["reread"]}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["code", "retryable", "next_action"],
          "properties": {
            "code": {"enum": ["approval_required"]},
            "retryable": {"const": false},
            "next_action": {"enum": ["await_approval"]}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["code", "retryable", "next_action"],
          "properties": {
            "code": {"enum": ["projection_pending", "calculation_pending"]},
            "retryable": {"const": true},
            "next_action": {"enum": ["retry_read"]}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["code", "retryable", "next_action"],
          "properties": {
            "code": {"enum": ["evidence_unavailable", "idempotency_window_expired"]},
            "retryable": {"const": false},
            "next_action": {"enum": ["inspect_history"]}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["code", "retryable", "next_action"],
          "properties": {
            "code": {"enum": ["limit_exceeded"]},
            "retryable": {"const": false},
            "next_action": {"enum": ["narrow"]}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["code", "retryable", "next_action"],
          "properties": {
            "code": {"enum": ["temporarily_unavailable"]},
            "retryable": {"const": true},
            "next_action": {"enum": ["status", "retry_read"]}
          },
          "additionalProperties": false
        }
      ]
    },
    "request": {
      "type": "object",
      "required": ["version", "operation", "input"],
      "properties": {"version": {"const": 1}, "operation": {"$ref": "#/$defs/operation"}, "input": {"type": "object"}},
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"required": ["operation"], "properties": {"operation": {"const": "office.search"}}},
          "then": {"properties": {"input": {"$ref": "#/$defs/searchInput"}}}
        },
        {
          "if": {"required": ["operation"], "properties": {"operation": {"const": "office.read"}}},
          "then": {"properties": {"input": {"$ref": "#/$defs/readInput"}}}
        },
        {
          "if": {"required": ["operation"], "properties": {"operation": {"const": "office.describe"}}},
          "then": {"properties": {"input": {"$ref": "#/$defs/describeInput"}}}
        },
        {
          "if": {"required": ["operation"], "properties": {"operation": {"const": "office.prepare"}}},
