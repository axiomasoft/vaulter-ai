{
    "name": "axiomasoft/vaulter-ai-agentools",
    "description": "Vaulter AI AgenTools adapter: ToolPort, ToolDescriptorRegistry, and ActionKeyMap over agentools/sdk.",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://github.com/axiomasoft/vaulter-ai",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4 <8.6",
        "agentools/sdk": "^1.0",
        "axiomasoft/vaulter-ai-core": "self.version",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Vaulter\\Ai\\AgenTools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vaulter\\Ai\\AgenTools\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vaulter\\Ai\\AgenTools\\AgenToolsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
